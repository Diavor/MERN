# Copy to .env and fill in. The API validates these at boot (backend/config/env.js)
# and refuses to start if anything required is missing or malformed.

# development | test | production
NODE_ENV=development
PORT=5001

# MongoDB connection string (use a replica set URI in production)
MONGO_URI=mongodb://127.0.0.1:27017/mern-shop

# Auth secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be >= 16 chars. JWT_REFRESH_SECRET is REQUIRED in production.
JWT_SECRET=change-me-min-16-characters
JWT_REFRESH_SECRET=change-me-min-16-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Rate limiting (global API limiter)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Image storage: "local" (uploads/) or "s3" (requires S3_BUCKET + S3_REGION in prod)
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=

# Comma-separated first-party origins for CORS (empty = same-origin only)
CORS_ORIGINS=

# Legacy — unused by the manual-payment flow
PAYPAL_CLIENT_ID=
